@end

# Modificare la porta esposta da ns3 che deve essere 80xx

@term
$ > more compose.yml
| services:
|   ns3:
|     privileged: true
|     container_name: ns3
|     hostname: ns3
|     image: cyberteam1/nginx-ssh
|     network_mode: bridge
|     ports:
|       - "8006:8006"
|     volumes:
|       - '../Scrivania/Unipr/RetiDeiCalcolatori/RETI2425/DockerHTTP:/var/www/html'
|
|
|   ns2:
|     container_name: ns2
|     hostname: ns2
|     image: cyberteam1/nginx-ssh
|     network_mode: bridge
|     volumes:
|       - '../Scrivania/Unipr/RetiDeiCalcolatori/RETI2425/DockerHTTP:/var/www/html'
@end

@term
$ > docker-compose up -d
| Creating ns3 ... done
| Creating ns2 ... done
@end

# Utilizzeremo ns3 come server e ns2 come client.

